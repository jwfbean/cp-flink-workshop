{
  "apiVersion": "cmf.confluent.io/v1",
  "kind": "KafkaCatalog",
  "metadata": {
    "name": "kcat"
  },
  "spec": {
    "srInstance": {
      "connectionConfig": {
        "schema.registry.url": "http://schemaregistry.confluent.svc.cluster.local:8081"
      }
    },
    "kafkaClusters": [
      {
        "databaseName": "kafka-jwfbean",
        "connectionConfig": {
          "bootstrap.servers": "kafka.confluent.svc.cluster.local:9071"
        }
      }
    ]
  }
}
